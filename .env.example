# Copy to `.env` and fill in as needed. NEVER commit the real `.env`.
#
# The platform is designed to run with ZERO secrets for research, backtesting
# and paper trading. Everything below is optional and only enables extras.

# --- Runtime mode: BACKTEST | PAPER | RESEARCH | ANALYSIS ---
# LIVE is intentionally not a supported value.
TRADING_MODE=RESEARCH

# --- Global kill switch. Must be "true" for any (paper) order to be placed. ---
TRADING_ENABLED=false

# --- Optional alerting integrations (all disabled by default) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# --- Optional alternative data providers (not required) ---
# Only used if you explicitly switch the provider in configs/data.yaml.
# ALPHAVANTAGE_API_KEY=
